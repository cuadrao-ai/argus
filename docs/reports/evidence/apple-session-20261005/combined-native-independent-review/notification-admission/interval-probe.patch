+private final class IntervalDispatchProbe: @unchecked Sendable {
+    private let lock = NSLock()
+    private var value = "not run"
+    private var observer: AnyCancellable?
+    @MainActor private var released = false
+    @MainActor func release() { released = true }
+    var result: String { lock.lock(); defer { lock.unlock() }; return value }
+    private func record(_ value: String) { lock.lock(); defer { lock.unlock() }; self.value = value }
+
+    @MainActor
+    func arm(model: ProfileAuthModel, controller: SessionController, identity: SessionSnapshot, checker: HarnessAppleChecker) {
+        released = false
+        observer = model.$state.dropFirst().filter { [self] _ in released }.prefix(1).sink { [self] _ in
+            let checked = checker.count
+            let barrier = DispatchSemaphore(value: 0)
+            Task.detached { [self] in
+                do {
+                    _ = try await controller.financialAccount(id: UUID(uuidString: "71d866ac-e53d-47f0-b1fa-eb4008d4c211")!, expectedIdentity: identity)
+                    record("unexpected account")
+                } catch {
+                    record(error as? SessionFailure == .rejected(status: 404, code: "interval_probe_dispatched") ? "DISPATCHED at check \(checked)" : "BLOCKED \(String(describing: error as? SessionFailure)) at check \(checked)")
+                }
+                barrier.signal()
+            }
+            if barrier.wait(timeout: .now() + 5) == .timedOut { record("probe timeout") }
+        }
+    }
+}
+
