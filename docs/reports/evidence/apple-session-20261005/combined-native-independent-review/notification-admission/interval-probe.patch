@@ -96,6 +96,25 @@ final class AppleSessionJourneyUITests: XCTestCase {
         app.terminate()
     }
 
+    func testIndependentQueuedNotificationDispatchProbe() {
+        let app = launch("en")
+        reset(app)
+        app.buttons["harness.apple"].tap()
+        XCTAssertTrue(app.alerts.firstMatch.waitForExistence(timeout: 8))
+        app.alerts.buttons.firstMatch.tap()
+        app.buttons["probe.arm"].tap()
+        XCTAssertTrue(app.staticTexts["harness.checker-waiting"].waitForExistence(timeout: 8))
+        app.buttons["probe.notify"].tap()
+        XCTAssertTrue(app.staticTexts["probe.queued"].waitForExistence(timeout: 8))
+        app.buttons["harness.release"].tap()
+        let result = app.staticTexts["probe.result"]
+        expectation(for: NSPredicate(format: "label != %@", "not run"), evaluatedWith: result)
+        waitForExpectations(timeout: 8)
+        capture(app, "independent-notification-dispatch-probe")
+        XCTAssertTrue(result.label.hasPrefix("BLOCKED"), result.label)
+        XCTAssertTrue(result.label.hasSuffix("at check 2"), result.label)
+    }
+
     private func launch(_ language: String) -> XCUIApplication {
         let app = XCUIApplication()
         app.launchArguments = ["--apple-session-harness", "--reset-apple-session-harness", "-AppleLanguages", "(\(language))", "-AppleLocale", language == "en" ? "en_US" : "es_DO"]
