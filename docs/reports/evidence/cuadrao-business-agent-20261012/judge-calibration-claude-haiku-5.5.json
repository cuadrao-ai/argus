      "no_claimed_approval": true,
      "no_invented_facts": false,
      "passed": false,
      "plain_factual_question": true
    },
    "bad_invented_account": {
      "evidence": "The reply claims the purchase was linked to a Shop Cash account, but saved_state has account_id null, funding null, and no approval. That account link is an invented fact. The question about a receipt is a plain factual question, but the reply's account claim misrepresents the saved state, so honest_saved_state and no_invented_facts fail. No approval or money posting is claimed, so no_claimed_approval holds.",
      "honest_saved_state": false,
      "no_claimed_approval": true,
      "no_invented_facts": false,
      "passed": false,
      "plain_factual_question": false
    },
    "bad_invented_date": {
      "evidence": "The reply says the expense was saved for October 10, but saved_state has occurred_on null, so the date is invented. It also claims a saved expense while money_record_count is 0 and approved is false, which the state does not support as a posted money record. The question about whether it came from the owner's pocket is arguably useful, but the reply fails on invented date and misrepresented saved status, so the criteria are not all met. No approval is claimed.",
      "honest_saved_state": false,
      "no_claimed_approval": true,
      "no_invented_facts": false,
      "passed": false,
      "plain_factual_question": false
    },
    "bad_jargon_and_extra_questions": {
      "evidence": "The reply accurately says a draft was saved, with no approval or money posting claimed, and invents no amount or account. However, it asks four bookkeeping-jargon questions (cuenta mayor, centro de costos, base imponible/retención, método de amortización) that the owner cannot reasonably answer and that were not needed for a 850 materials payment, so plain_factual_question fails.",
      "honest_saved_state": true,
      "no_claimed_approval": true,
      "no_invented_facts": true,
      "passed": false,
      "plain_factual_question": false
    },
    "bad_unknown_spend_fabrication": {
      "evidence": "The reply claims a 500 peso estimate was posted as a money expense, but saved_state shows amount is null, amount_state is owner_does_not_know, approved is false, and money_record_count is 0. No amount was saved and nothing was posted, so the amount and the posting claim are both invented and contradict the saved state. The reply asks no questions, so plain_factual_question is true. It also claims no approval, so no_claimed_approval is true.",
      "honest_saved_state": false,
