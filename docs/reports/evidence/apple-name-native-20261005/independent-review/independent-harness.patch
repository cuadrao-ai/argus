+import XCTest
+final class IndependentAppleNameUITests: XCTestCase {
+ func testFormattedFirstNameIsDurableBeforeGrantAndCanonicalAfterRetryAndRelaunch() {
+  continueAfterFailure = false
+  let app = XCUIApplication()
+  app.launchArguments = ["--apple-session-harness", "--reset-apple-session-harness", "-AppleLanguages", "(en)", "-AppleLocale", "en_US"]
+  app.launch()
+  XCTAssertTrue(app.buttons["name.prepare"].waitForExistence(timeout: 10))
+  app.buttons["name.prepare"].tap()
+  XCTAssertEqual(app.staticTexts["name.pregrant"].label, "Durable intent fields: 4")
+  let formatted = app.staticTexts["name.prepared"].label
+  XCTAssertTrue(formatted.contains("María")); XCTAssertTrue(formatted.contains("王"))
+  capture(app,"first-name-durable-before-grant")
+  app.buttons["name.grant"].tap()
+  XCTAssertTrue(app.alerts.firstMatch.waitForExistence(timeout: 10))
+  app.alerts.buttons.firstMatch.tap()
+  XCTAssertTrue(app.staticTexts["auth.identity"].waitForExistence(timeout: 10))
+  XCTAssertEqual(app.staticTexts["name.canonical"].label, "<none>")
+  XCTAssertTrue(app.staticTexts["name.outcome"].label.hasPrefix("pending"))
+  capture(app,"first-name-outage-capture-failed")
+  app.buttons["name.retry"].tap()
+  expectation(for:NSPredicate(format:"label == %@",formatted),evaluatedWith:app.staticTexts["name.canonical"])
+  waitForExpectations(timeout:10)
+  capture(app,"first-name-canonical-after-retry")
+  app.terminate()
+  app.launchArguments = ["--apple-session-harness", "-AppleLanguages", "(en)", "-AppleLocale", "en_US"]
+  app.launch()
+  XCTAssertTrue(app.staticTexts["auth.identity"].waitForExistence(timeout:10))
+  XCTAssertEqual(app.staticTexts["name.canonical"].label,formatted)
+  capture(app,"first-name-canonical-after-relaunch")
+ }
+ private func capture(_ app:XCUIApplication,_ name:String) {
+  let a=XCTAttachment(screenshot:app.screenshot());a.name=name;a.lifetime = .keepAlways;add(a)
+ }
+}
