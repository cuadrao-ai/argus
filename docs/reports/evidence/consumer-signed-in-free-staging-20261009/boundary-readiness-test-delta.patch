+    func testRetainedCoverageAfterBoundaryRepair() throws {
+        let environment = ProcessInfo.processInfo.environment
+        let bankID = try XCTUnwrap(environment["ARGUS_TEST_RECONCILE_BANK_ID"])
+        let cashID = try XCTUnwrap(environment["ARGUS_TEST_RECONCILE_CASH_ID"])
+        let cashName = try XCTUnwrap(environment["ARGUS_TEST_RECONCILE_CASH_NAME"])
+        let bank = MoneyAccount(name: "Retained reconciliation bank", id: try XCTUnwrap(UUID(uuidString: bankID)).uuidString)
+        let cash = MoneyAccount(name: cashName, id: try XCTUnwrap(UUID(uuidString: cashID)).uuidString)
+        try signIn()
+        openMoneyAccount(bank)
+        tapVisible(app.buttons["accounts.record"])
+        app.buttons["loop.kind.transfer"].tap()
+        chooseMoneyAccount("loop.destination", account: cash)
+        fillMoneyField("loop.amount", with: "60")
+        fillMoneyField("loop.note", with: "Unsaved boundary verification")
+        dismissMoneyKeyboard()
+        reviewMoney(answersByAccount: [bank.id.lowercased(): [false, true]])
+        XCTAssertTrue(app.buttons["loop.confirm"].waitForExistence(timeout: 10))
+        capture("footer-boundary-coverage-ready-unsaved")
+        let back = app.navigationBars["Review transaction"].buttons["Back"]
+        let ready = NSPredicate { _, _ in back.exists && back.isEnabled && back.isHittable }
+        XCTAssertEqual(XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: ready, object: nil)], timeout: 10), .completed)
+        back.tap()
+        let cancel = app.navigationBars["Add transaction"].buttons["Cancel"]
+        XCTAssertTrue(cancel.waitForExistence(timeout: 10))
+        cancel.tap()
+        XCTAssertTrue(app.buttons["accounts.record"].waitForExistence(timeout: 10))
+    }
