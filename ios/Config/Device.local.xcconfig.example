// Copy to ignored Device.local.xcconfig only after approving the Apple team and app ID.
SUPPORTED_PLATFORMS = iphoneos
CODE_SIGN_STYLE = Automatic
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES
CODE_SIGN_IDENTITY = Apple Development
// The app always requests Declared Age Range. Provisioning must include this capability.
CODE_SIGN_ENTITLEMENTS = Config/DeclaredAgeRange.entitlements
// Sign in with Apple: only after the capability is enabled on this App ID in the Apple
// Developer portal (AUTH_SETUP.md), replace the line above with:
// CODE_SIGN_ENTITLEMENTS = Config/SignInWithApple.entitlements
// and set ARGUS_APPLE_SIGN_IN_ENABLED = true.
DEVELOPMENT_TEAM =
ARGUS_LOCAL_BUNDLE_IDENTIFIER =
// Add the approved public endpoints using Local.xcconfig.example as the key list.
// Do not use loopback URLs or Cloudflare test keys for the internet build.
ARGUS_AUTH_ENABLED = false
