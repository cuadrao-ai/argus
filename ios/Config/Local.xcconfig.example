// Optional ignored simulator configuration. Production identity is unresolved.
ARGUS_LOCAL_BUNDLE_IDENTIFIER = local.argus.foundation
// Default off. See ../AUTH_SETUP.md before enabling.
ARGUS_AUTH_ENABLED = false
// Legal links remain hidden pending approval of app-policy URLs.
ARGUS_CUADRAO_LEGAL_LINKS_ENABLED = false
ARGUS_CUADRAO_TERMS_URL = https:/$()/cuadrao.ai/terminos
ARGUS_CUADRAO_PRIVACY_URL = https:/$()/cuadrao.ai/privacidad
// Root origins, no /api/v1 suffix. xcconfig requires :/$()/ for URL slashes.
ARGUS_API_URL =
ARGUS_SUPABASE_URL =
ARGUS_SUPABASE_ANON_KEY =
ARGUS_WEB_URL =
// Exact main-frame bridge URL. HTTPS, or loopback HTTP for local development.
ARGUS_CAPTCHA_URL =
// Public anon key only. Never add passwords, service-role keys or session tokens.
// Native sign-in (default off). Turn on only after the AUTH_SETUP.md provider steps.
ARGUS_APPLE_SIGN_IN_ENABLED = false
ARGUS_GOOGLE_SIGN_IN_ENABLED = false
ARGUS_BETA_INVITES_ENABLED = false
ARGUS_INVITE_UNIVERSAL_LINK_ENABLED = false
GOOGLE_SIGN_IN_IOS_CLIENT_ID =
GOOGLE_SIGN_IN_WEB_CLIENT_ID =
GOOGLE_SIGN_IN_IOS_URL_SCHEME = argus-google-sign-in-unconfigured
