      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a share from 0.01 to 100, using a decimal point."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa una parte de 0.01 a 100, usando un punto decimal."
          }
        }
      }
    },
    "accounts.error.stale_version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account changed after you opened it. Review its current record."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta cambió desde que la abriste. Revisa el registro actual."
          }
        }
      }
    },
    "accounts.error.time_zone_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid IANA time zone, such as America/Santo_Domingo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa una zona horaria IANA válida, como America/Santo_Domingo."
          }
        }
      }
    },
    "accounts.error.type_locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account type cannot change while activity exists."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de cuenta no puede cambiar mientras tenga actividad."
          }
        }
