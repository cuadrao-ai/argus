    },
    "accounts.error.amount_out_of_range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This amount is too large to record."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El monto es demasiado grande para registrarlo."
          }
        }
      }
    },
    "accounts.error.amount_precision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This amount has more decimal places than the currency allows."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El monto tiene más decimales de los que permite la moneda."
          }
        }
      }
    },
    "accounts.error.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm the result. Check your connection and try again."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos confirmar el resultado. Revisa tu conexión y reintenta."
          }
        }
      }
    },
    "accounts.error.currency_locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency cannot change after a balance has been recorded."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La moneda no puede cambiar después de registrar un saldo."
          }
        }
      }
    },
    "accounts.error.currency_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This currency code is not supported."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de moneda no es compatible."
          }
        }
      }
    },
    "accounts.error.date_in_future": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a date that is not in the future."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una fecha que no sea futura."
          }
        }
      }
    },
    "accounts.error.date_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete date and time with its UTC offset."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa una fecha y hora completas con su diferencia UTC."
          }
        }
      }
    },
    "accounts.error.field_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change an amount, date or time zone to save a correction."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia un monto, fecha o zona horaria para guardar la corrección."
          }
        }
      }
    },
    "accounts.error.financial_account_not_found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is no longer available to you."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta ya no está disponible para ti."
          }
        }
      }
    },
    "accounts.error.financial_accounts_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Financial accounts are not available in this environment."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas financieras no están disponibles en este entorno."
          }
        }
      }
