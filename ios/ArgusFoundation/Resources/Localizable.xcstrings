    "accounts.error.idempotency_conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request does not match the earlier create attempt. Check your account list."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud no coincide con el intento anterior. Revisa tus cuentas."
          }
        }
      }
    },
    "accounts.error.nature_change_requires_empty_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with a recorded balance cannot switch between an asset and a debt."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta con saldo registrado no puede cambiar entre activo y deuda."
          }
        }
      }
    },
    "accounts.error.nickname_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a nickname of at most 60 characters."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un nombre de hasta 60 caracteres."
          }
        }
      }
    },
    "accounts.error.reason_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a correction reason of at most 200 characters."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un motivo de hasta 200 caracteres."
          }
        }
      }
