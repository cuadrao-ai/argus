    "accounts.date.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 2026-09-01T09:00:00-04:00. Keep the original value to preserve the recorded instant."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: 2026-09-01T09:00:00-04:00. Conserva el valor original para mantener el instante registrado."
          }
        }
      }
    },
    "accounts.disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These fixed examples show the layout. Adding, editing and saving accounts are not connected."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos ejemplos fijos muestran el diseño. Agregar, editar y guardar cuentas no está conectado."
          }
        }
      }
    },
    "accounts.edit": {
      "extractionState": "manual",
