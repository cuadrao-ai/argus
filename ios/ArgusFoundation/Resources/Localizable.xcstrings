    "accounts.amount.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a decimal point, for example 1250.25. Do not include a currency symbol or grouping separators."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un punto decimal, por ejemplo 1250.25. No incluyas símbolos de moneda ni separadores de miles."
          }
        }
      }
    },
    "accounts.amount.optional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank if you do not know the balance. Zero is a known balance."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco si no conoces el saldo. Cero es un saldo conocido."
