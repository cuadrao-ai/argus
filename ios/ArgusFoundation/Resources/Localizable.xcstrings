    "accounts.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record cash, a bank account, debt, or an asset. You can leave its starting balance unknown."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra efectivo, una cuenta bancaria, una deuda o un activo. Puedes dejar el saldo inicial sin conocer."
          }
        }
      }
    },
    "accounts.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one account"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con una cuenta"
          }
        }
      }
    },
    "accounts.error.account_conversion_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A registered account is required to manage financial accounts."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas una cuenta registrada para administrar cuentas financieras."
          }
