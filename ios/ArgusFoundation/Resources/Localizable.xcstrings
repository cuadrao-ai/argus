    },
    "accounts.error.validation_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the entered details and try again."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los datos y reintenta."
          }
        }
      }
    },
    "accounts.form.title": {
      "extractionState": "manual",
