    "sheet.sample.detail": {
      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un ejemplo local de la interfaz. La navegación, la búsqueda de ejemplos y la apariencia funcionan. Los registros financieros, el chat, los archivos y las acciones de cuenta no están conectados ni se guardan."
