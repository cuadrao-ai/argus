    "copy.releaseDeleteAccountView.8244b5e893": {
      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En los planes que compartes, tus montos se quedan para que las cuentas de los demás sigan cuadrando, pero sin tu nombre: aparecerás como «Exmiembro». Tus recibos y notas se borran. Lo que debes o te deben queda cerrado en la app, no marcado como pagado. Los planes que creaste pasan a la persona que lleva más tiempo en cada uno, salvo los planes de deuda compartidos, que se cierran y quedan solo para consulta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In plans you share, your amounts stay so everyone else's numbers still add up, but without your name: you'll show as \"Former member.\" Your receipts and notes are deleted. Anything you owe or are owed is closed in the app, not marked as paid. Plans you created pass to whoever has been in each one longest, except shared debt plans, which are closed and stay view-only."
          }
        }
      },
      "comment": "Existing copy at fb6d969505f364fa08e4eb89e7317619f7de4781 in ios/ArgusFoundation/ReleaseUI/Identity/ReleaseDeleteAccountView.swift"
    },
