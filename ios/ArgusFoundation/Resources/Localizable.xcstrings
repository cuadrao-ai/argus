    "accounts.amount.format": {
      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un punto decimal, por ejemplo 1250.25. No incluyas símbolos de moneda ni separadores de miles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a decimal point, for example 1250.25. Do not include a currency symbol or grouping separators."
          }
        }
      },
      "comment": "Existing Spanish catalog source at fb6d969505f364fa08e4eb89e7317619f7de4781 in ios/ArgusFoundation/Resources/es-419.lproj/Localizable.strings"
