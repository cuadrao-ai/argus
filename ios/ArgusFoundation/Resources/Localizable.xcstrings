    "accounts.create.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain. Try again with this same saved request to avoid a duplicate. Cancel abandons this retry; check your account list before creating another."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es incierto. Reintenta con esta misma solicitud para evitar duplicados. Cancelar abandona el reintento; revisa tus cuentas antes de crear otra."
          }
        }
      }
    },
    "accounts.creditBalance": {
