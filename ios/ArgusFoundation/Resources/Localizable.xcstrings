      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por tres cosas: cuánto tiempo puedes dejar ese dinero, qué rendimiento ofrece y qué pasa si lo necesitas antes."
