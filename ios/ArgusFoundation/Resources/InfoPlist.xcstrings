{
  "sourceLanguage": "es-419",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuadrao usa la cámara para escanear tus recibos. Solo se guarda lo que tú elijas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuadrao uses the camera to scan your receipts. Only what you choose is saved."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu ubicación actual a un recibo solo cuando lo elijas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your current location to a receipt only when you choose to."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una tarjeta de grupo de muestra en Fotos cuando elijas Guardar imagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a sample group card to Photos when you choose Save Image."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuadrao"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuadrao"
          }
        }
      }
    }
  },
  "version": "1.0"
}
