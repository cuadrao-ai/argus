{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.github/agent-session-context.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
