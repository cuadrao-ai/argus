# Frontend environment (copy to .env.local and fill in values)
#   cp web/.env.local.example web/.env.local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Auth bypass for UI-only local development. Keep false to test real Supabase auth.
NEXT_PUBLIC_MOCK_AUTH=false
NEXT_PUBLIC_GUEST_ACCESS_ENABLED=true
# Required for Guest entry from a non-loopback production host.
NEXT_PUBLIC_ARGUS_TURNSTILE_SITE_KEY=

# Local API URL (must match your FastAPI backend address)
NEXT_PUBLIC_ARGUS_API_URL=http://127.0.0.1:8000/api/v1

# Exact public web origin used to build password-recovery redirects in QA/prod.
ARGUS_APP_ORIGIN=http://localhost:3000

# Public support address rendered on the privacy page, terms page, and profile
# menu (and used as the mail fallback when in-app support submission fails).
# support@get-argus.com forwards via Cloudflare Email Routing.
NEXT_PUBLIC_ARGUS_SUPPORT_EMAIL=support@get-argus.com

# Feature flags
NEXT_PUBLIC_ENABLE_SPANISH=true
NEXT_PUBLIC_OMNISEARCH_ENABLED=true
NEXT_PUBLIC_RESEARCH_RAIL_ENABLED=false
# Cuadrao Business owner pilot screens at /biz. Keep false outside the pilot.
NEXT_PUBLIC_BUSINESS_PILOT_ENABLED=false

# QA-only CAPTCHA bypass token for local guest journeys against a local
# Supabase stack. NEVER set on hosted services.
NEXT_PUBLIC_ARGUS_LOCAL_QA_CAPTCHA_TOKEN=
