exports[`disabled slot phone_changed_notification HTML/plain snapshot and light/dark AA 1`] = `
{
  "html": 
"<!doctype html><html lang="es"><head><meta charset="utf-8"><title></title><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><style>@media(prefers-color-scheme:dark){
    .page{background:#111c18!important}.card,.footer{background:#172b26!important}
    .copy{color:#fafbf8!important}.title{color:#b6e87a!important}
    .muted,.muted a{color:#cfdccf!important}.fallback{background:#293b33!important;color:#fafbf8!important}
    .code{background:#304834!important;color:#fafbf8!important}
    .button{background:#b6e87a!important;color:#172b26!important}
  }[data-ogsc] .page{background:#111c18!important}[data-ogsc] .card,[data-ogsc] .footer{background:#172b26!important}[data-ogsc] .copy{color:#fafbf8!important}[data-ogsc] .title{color:#b6e87a!important}[data-ogsc] .muted,[data-ogsc] .muted a{color:#cfdccf!important}[data-ogsc] .fallback{background:#293b33!important;color:#fafbf8!important}[data-ogsc] .code{background:#304834!important;color:#fafbf8!important}[data-ogsc] .button{background:#b6e87a!important;color:#172b26!important}
  </style></head>
<body class="page" style="margin:0;padding:32px 12px;background:#f7f5ee;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,Helvetica,sans-serif"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center"><table class="card" role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:100%;max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden"><tr><td style="padding:6px 14px;background:#172b26;border-radius:12px 12px 0 0">
<img src="https://cuadrao.ai/email/lockup-dark.png" alt="Cuadrao" width="209" height="72" style="display:block;border:0;color:#fafbf8;font-size:24px;line-height:72px;font-weight:bold;text-indent:18px">
</td></tr><tr><td style="padding:28px 32px 8px"><h1 class="title" style="margin:0 0 24px;color:#172b26;font-size:24px;line-height:32px;font-weight:700"></h1></td></tr><tr><td class="footer" style="padding:20px 32px 28px;background:#ffffff"><p class="copy" style="margin:0 0 12px;color:#172b26;font-size:16px;line-height:24px">Saludos,<br>Cuadrao</p><p class="muted" style="margin:0;color:#56635e;font-size:14px;line-height:21px">¿Necesitas ayuda? Escríbenos a <a href="mailto:hola@cuadrao.ai" style="color:inherit;text-decoration:underline">hola@cuadrao.ai</a></p><p class="muted" style="margin:16px 0;color:#56635e;font-size:14px;line-height:21px">Cuadrao LLC</p></td></tr></table></td></tr></table></body></html>"
,
  "sendable": false,
  "subject": "",
  "text": 
"Saludos,
Cuadrao

¿Necesitas ayuda? Escríbenos a hola@cuadrao.ai

Cuadrao LLC"
,
}
`;

