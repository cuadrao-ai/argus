{
  "version": 2,
  "kinds": {
    "plain": "value in this file, or keep_current (live value kept), or copy_from (live value of a twin name, used only while the name is absent)",
    "secret": "value from the local secrets file; keep_current keeps the live value and never reads the file",
    "generated": "random value created once in the local secrets file and never overwritten"
  },
  "production_rules": {
    "value": "this exact value",
    "copy_from": "the live value of the named variable on this service (or on the service named by service), used once while the name is absent",
    "enter": "a value you type in; the text says where it comes from; optional means it may stay absent",
    "not_set": "the name must not exist on the production service",
    "production_only": "true on an entry the staging commands never read or write"
  },
