=\"0\" style=\"width:100%;max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden\"><tr><td style=\"padding:24px 32px;background:#172b26;border-radius:12px 12px 0 0\">\n<img class=\"logo-light\" src=\"https://cuadrao-email-assets.invalid/email/wordmark-light.png\" alt=\"Cuadrao\" width=\"168\" height=\"36\" style=\"display:block;border:0;color:#fafbf8;font-size:24px;font-weight:bold\">\n<!--[if !mso]><!--><img class=\"logo-dark\" src=\"https://cuadrao-email-assets.invalid/email/wordmark-dark.png\" alt=\"Cuadrao\" width=\"168\" height=\"36\" style=\"display:none;max-height:0;overflow:hidden;border:0;color:#fafbf8;font-size:24px;font-weight:bold\"><!--<![endif]-->\n</td></tr><tr><td style=\"padding:28px 32px 8px\"><h1 class=\"title\" style=\"margin:0 0 24px;color:#172b26;font-size:24px;line-height:32px;font-weight:700\">You already have an account</h1><p class=\"copy\" style=\"margin:0 0 20px;color:#172b26;font-size:16px;line-height:24px\">Hi,</p><p class=\"copy\" style=\"margin:0 0 20px;color:#172b26;font-size:16px;line-height:24px\">Someone tried to create a new Cuadrao account with this email, but you already have one.</p><p class=\"copy\" style=\"margin:0 0 20px;color:#172b26;font-size:16px;line-height:24px\">Sign in with your password. If you forgot it, tap Forgot password? on the sign-in screen.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:4px 0 20px\">\n<!--[if mso]><v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://cuadrao-existing-account.invalid/?auth=login\" style=\"height:48px;v-text-anchor:middle;width:496px\" arcsize=\"16%\" stroke=\"f\" fillcolor=\"#172b26\"><w:anchorlock/><center style=\"color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold\">Sign in</center></v:roundrect><![endif]-->\n<!--[if !mso]><!--><a class=\"button\" href=\"https://cuadrao-existing-account.invalid/?auth=login\" style=\"display:block;box-sizing:border-box;width:100%;min-height:48px;padding:12px 16px;border-radius:8px;background:#172b26;color:#ffffff;font-size:16px;line-height:24px;font-weight:700;text-decoration:none;text-align:center\">Sign in</a><!--<![endif]-->\n</td></tr></table><p class=\"fallback\" style=\"margin:0 0 20px;padding:16px;background:#eef0ed;color:#172b26;border-radius:8px;font-size:14px;line-height:21px;overflow-wrap:anywhere;word-break:break-all\"><a class=\"fallback\" href=\"https://cuadrao-existing-account.invalid/?auth=login\" style=\"color:#172b26;text-decoration:underline;overflow-wrap:anywhere;word-break:break-all\">https://cuadrao-existing-account.invalid/?auth=login</a></p><p class=\"muted\" style=\"margin:16px 0;color:#56635e;font-size:14px;line-height:21px\">If this was not you, ignore this email. Your account has not changed.</p></td></tr><tr><td class=\"footer\" style=\"padding:20px 32px 28px;background:#ffffff\"><p class=\"copy\" style=\"margin:0 0 12px;color:#172b26;font-size:16px;line-height:24px\">Regards,<br>Cuadrao</p><p class=\"muted\" style=\"margin:0;color:#56635e;font-size:14px;line-height:21px\">Need help? Email <a href=\"mailto:hola@cuadrao.ai\" style=\"color:inherit;text-decoration:underline\">hola@cuadrao.ai</a></p><p class=\"muted\" style=\"margin:16px 0;color:#56635e;font-size:14px;line-height:21px\">Cuadrao LLC</p></td></tr></table></td></tr></table></body></html>",
      "text": "You already have an account\n\nHi,\n\nSomeone tried to create a new Cuadrao account with this email, but you already have one.\n\nSign in with your password. If you forgot it, tap Forgot password? on the sign-in screen.\n\nSign in\nhttps://cuadrao-existing-account.invalid/?auth=login\n\nIf this was not you, ignore this email. Your account has not changed.\n\nRegards,\nCuadrao\n\nNeed help? Email hola@cuadrao.ai\n\nCuadrao LLC"
    }
