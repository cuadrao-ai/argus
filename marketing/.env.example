# Cuadrao marketing website. Every value is optional locally: without them the
# pages render and each form shows its unavailable state. Contract and owners:
# docs/specs/cuadrao-marketing-forms-contract.md

# Business inquiries (Resend). The key is a secret; set it only on the service.
RESEND_API_KEY=
CUADRAO_INQUIRY_FROM=Cuadrao <website@notify.cuadrao.ai>
# Where inquiries are delivered. No default: unset, the form is unavailable.
CUADRAO_INQUIRY_TO=

# Personal early-access signups (existing Supabase project). The service-role
# key is a secret; set it only on the service and the operator's shell.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to "public" only on the approved public host. Any other value, or none,
# sends noindex and a disallow-all robots.txt.
CUADRAO_SITE_INDEXING=

# Only when a trusted proxy such as Cloudflare is in front of the service. Unset
# on the Render address, where the rightmost X-Forwarded-For entry is used.
CUADRAO_TRUSTED_CLIENT_IP_HEADER=

# Shows the planned social icons as non-clickable placeholders in the footer.
# Leave unset in production: an icon appears on its own once its account link is
# set in lib/social.ts. Pages are rendered ahead of time, so set it at build.
CUADRAO_SOCIAL_PREVIEW=

# Optional HTTPS origin for /email/wordmark-light.png and wordmark-dark.png.
# Unset uses https://cuadrao.ai. No path, credentials, query or fragment.
CUADRAO_EMAIL_ASSET_ORIGIN=
