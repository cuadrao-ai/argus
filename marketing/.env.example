# Canonical Marketing environment inventory. Empty placeholders only.
# Value sources, approval gates, and group setup: PRODUCTION_CHECKLIST.md.
# Create groups unlinked. Linking a Render group starts a deploy.
# Mirror each prod group as cuadrao-staging-shared / cuadrao-staging-web,
# with IDENTICAL variable names and staging-only values. Never copy prod secrets.
# No variable belongs to both shared and web. Service values override groups.

# cuadrao-prod-shared / cuadrao-staging-shared. Required shared settings.
# Server-only Supabase project URL, service-role key, and Resend credential.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
MARKETING_WAITLIST_FROM=

# cuadrao-prod-web / cuadrao-staging-web. Required Marketing settings.
# CUADRAO_INQUIRY_FROM belongs to web by Lucas's explicit assignment.
MARKETING_POSTAL_ADDRESS=
CUADRAO_WAITLIST_ORIGIN=
CUADRAO_WAITLIST_TURNSTILE_SECRET=
CUADRAO_WAITLIST_TURNSTILE_SITE_KEY=
CUADRAO_INQUIRY_FROM=
CUADRAO_INQUIRY_TO=

# Optional web settings. Indexing is private unless explicitly set to public.
# Set trusted IP header only after verifying the proxy chain.
# Social preview is build-time only; leave unset on production.
CUADRAO_SITE_INDEXING=
CUADRAO_TRUSTED_CLIENT_IP_HEADER=
CUADRAO_SOCIAL_PREVIEW=

# Local provider fixture override. Never put this in either hosted group.
# Without an override the app uses https://api.resend.com.
RESEND_API_URL=

# Manual operator only. No launch notice is authorized by provisioning this file.
CUADRAO_NOTICE_FROM=

# Platform/build context. Render or CI supplies these; no shared/web group.
# PORT and NODE_ENV are framework inputs, not direct Marketing source reads.
PORT=
NODE_ENV=
CI=

# Local capture and test-only knobs. Never configure on the hosted service.
MARKETING_CAPTURE_URL=
MARKETING_E2E_MOCK_PORT=
MARKETING_E2E_SITE_PORT=
MARKETING_E2E_PUBLIC_PORT=
MOCK_PROVIDER_PORT=
CUADRAO_WAITLIST_TEST_CONTAINER=
